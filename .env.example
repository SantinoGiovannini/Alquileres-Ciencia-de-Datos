# Copiar a .env antes de levantar Airflow:  cp .env.example .env
#
# UID con el que corren los contenedores. En Linux/Mac conviene poner el
# propio (id -u) para que los archivos que escribe Airflow en data/ y logs/
# no queden como root. En Windows se deja 50000.
AIRFLOW_UID=50000

# Librerias que la imagen oficial de Airflow no trae.
# Se instalan al arrancar cada contenedor: alcanza para la cursada, pero
# no es lo recomendado para produccion (ahi va una imagen propia).
#
# scikit-learn lo usa transform.py para las features geograficas (KMeans
# para zona_geo, BallTree para densidad_1km). Venia en la imagen 3.3.1,
# pero se declara igual: si la imagen base cambia, el pipeline se rompe.
#
# Las herramientas para regenerar el notebook (matplotlib, nbformat,
# nbconvert, ipykernel) NO van aca a proposito: se instalarian en los seis
# contenedores y solo hacen falta en uno. El comando esta en el README.
_PIP_ADDITIONAL_REQUIREMENTS=requests beautifulsoup4 lxml scikit-learn

# El docker-compose 3.3.1 referencia esta variable sin valor por defecto.
# Vacia esta bien para desarrollo (no cifra las conexiones guardadas);
# en algo real se genera una con `python -c "from cryptography.fernet import
# Fernet; print(Fernet.generate_key().decode())"`.
FERNET_KEY=
